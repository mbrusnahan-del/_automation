      "parameters": {
        "language": "javaScript",
        "jsCode": "// Check brief completeness against required field list\nconst props = $input.first().json.properties || {};\nfunction richText(p) { return ((p && p.rich_text) || []).map(t => t.plain_text).join('').trim(); }\nfunction selectVal(p) { return (p && p.select && p.select.name) || ''; }\nconst required = {\n  'City':           richText(props.City),\n  'State':          richText(props.State),\n  'Jurisdiction':   richText(props.Jurisdiction),\n  'ICC Code Year':  selectVal(props['ICC Code Year']),\n  'Project Street': richText(props['Project Street']),\n};\nconst missing = Object.entries(required).filter(([k,v]) => !v).map(([k]) => k);\nreturn [{\n  json: {\n    page_id: $input.first().json.id,\n    complete: missing.length === 0,\n    missing: missing,\n    missing_count: missing.length,\n  }\n}];"
      },
