{
  "name": "KS B — Dispatch Contract Render (calls PC)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "triggerMode": "pagedUpdatedInDatabase",
        "databaseId": {
          "__rl": true,
          "value": "6b64658f-5fb3-4329-b02c-3ac3cb8a0828",
          "mode": "id"
        },
        "options": {}
      },
      "id": "b-trigger",
      "name": "Notion: Brief updated",
      "type": "n8n-nodes-base.notionTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "credentials": { "notionApi": { "name": "KS Notion" } }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ ($json.properties.Status.select && $json.properties.Status.select.name) || '' }}",
              "rightValue": "Approved",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ !!($json.properties['Rendered At'].date && $json.properties['Rendered At'].date.start) }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "b-gate",
      "name": "Gate: Status=Approved AND not yet rendered",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KS_WEBHOOK_BASE_URL }}/render-contract",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-KS-Token", "value": "={{ $env.KS_WEBHOOK_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brief_id: $json.id }) }}",
        "options": {
          "timeout": 60000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "b-dispatch",
      "name": "POST /render-contract to PC",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "notes": "60s timeout — contract rendering involves the docx template pipeline. PC server reports back with the contract path or an error."
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "b-success-check",
      "name": "Render succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Notion-Version", "value": "2025-09-03" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  parent: { type: 'data_source_id', data_source_id: '04d7aa20-eb8d-4d51-b302-25fb4eaaf26e' },\n  properties: {\n    'Log Entry': { title: [{ type: 'text', text: { content: 'B · Contract rendered for ' + (($('Notion: Brief updated').first().json.properties.Name.title[0] || {}).plain_text || '') + ' (via n8n)' } }] },\n    Job: { select: { name: 'B' } },\n    Outcome: { select: { name: 'Success' } },\n    Timestamp: { date: { start: new Date().toISOString() } },\n    Brief: { relation: [{ id: $('Notion: Brief updated').first().json.id }] },\n    Details: { rich_text: [{ type: 'text', text: { content: 'Contract: ' + ($json.contract || '') } }] }\n  }\n}) }}",
        "options": {}
      },
      "id": "b-log-ok",
      "name": "Log success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Notion-Version", "value": "2025-09-03" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  parent: { type: 'data_source_id', data_source_id: '04d7aa20-eb8d-4d51-b302-25fb4eaaf26e' },\n  properties: {\n    'Log Entry': { title: [{ type: 'text', text: { content: 'B · Contract render failed for ' + (($('Notion: Brief updated').first().json.properties.Name.title[0] || {}).plain_text || '') } }] },\n    Job: { select: { name: 'B' } },\n    Outcome: { select: { name: 'Failed' } },\n    Timestamp: { date: { start: new Date().toISOString() } },\n    Brief: { relation: [{ id: $('Notion: Brief updated').first().json.id }] },\n    Error: { rich_text: [{ type: 'text', text: { content: $json.error || 'dispatch failed' } }] }\n  }\n}) }}",
        "options": {}
      },
      "id": "b-log-fail",
      "name": "Log failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 400]
    }
  ],
  "connections": {
    "Notion: Brief updated": { "main": [[{ "node": "Gate: Status=Approved AND not yet rendered", "type": "main", "index": 0 }]] },
    "Gate: Status=Approved AND not yet rendered": { "main": [[{ "node": "POST /render-contract to PC", "type": "main", "index": 0 }]] },
    "POST /render-contract to PC": { "main": [[{ "node": "Render succeeded?", "type": "main", "index": 0 }]] },
    "Render succeeded?": {
      "main": [
        [{ "node": "Log success", "type": "main", "index": 0 }],
        [{ "node": "Log failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "ks-automation" }, { "name": "v2.1.2" }, { "name": "hybrid-pc" }]
}
