{
  "name": "KS D — Admins Notified on Brief Ready for Review",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "triggerMode": "pagedUpdatedInDatabase",
        "databaseId": {
          "__rl": true,
          "value": "6b64658f-5fb3-4329-b02c-3ac3cb8a0828",
          "mode": "id"
        },
        "options": {}
      },
      "id": "d-trigger",
      "name": "Notion: Brief updated",
      "type": "n8n-nodes-base.notionTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "credentials": { "notionApi": { "name": "KS Notion" } }
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ ($json.properties.Status.select && $json.properties.Status.select.name) || '' }}",
              "rightValue": "Ready for Admin Review",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.properties['Admins Notified'].checkbox }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        },
        "options": {}
      },
      "id": "d-gate",
      "name": "Gate: Status=Ready for Admin Review AND Admins Notified=false",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Notion-Version", "value": "2025-09-03" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  properties: {\n    'Admins Notified': { checkbox: true }\n  }\n}) }}",
        "options": {}
      },
      "id": "d-flip-admins",
      "name": "Flip Admins Notified = true",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.properties.Project.relation[0].id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Notion-Version", "value": "2025-09-03" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  properties: {\n    Status: { select: { name: 'Admin Review' } }\n  }\n}) }}",
        "options": {}
      },
      "id": "d-bump-project",
      "name": "Bump Project.Status = Admin Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300],
      "notes": "Uses the Brief's Project relation from the trigger payload. The Notion automation on Project.Status change pings admins."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Notion-Version", "value": "2025-09-03" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  parent: { type: 'data_source_id', data_source_id: '04d7aa20-eb8d-4d51-b302-25fb4eaaf26e' },\n  properties: {\n    'Log Entry': { title: [{ type: 'text', text: { content: 'D · Admins notified for ' + (($('Notion: Brief updated').first().json.properties.Name.title[0] || {}).plain_text || '') } }] },\n    Job: { select: { name: 'D' } },\n    Outcome: { select: { name: 'Success' } },\n    Timestamp: { date: { start: new Date().toISOString() } },\n    Brief: { relation: [{ id: $('Notion: Brief updated').first().json.id }] },\n    Project: { relation: [{ id: $('Notion: Brief updated').first().json.properties.Project.relation[0].id }] },\n    Details: { rich_text: [{ type: 'text', text: { content: 'Flags flipped; Notion automation handles admin notification.' } }] }\n  }\n}) }}",
        "options": {}
      },
      "id": "d-log",
      "name": "Log to Automation Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 300]
    }
  ],
  "connections": {
    "Notion: Brief updated": { "main": [[{ "node": "Gate: Status=Ready for Admin Review AND Admins Notified=false", "type": "main", "index": 0 }]] },
    "Gate: Status=Ready for Admin Review AND Admins Notified=false": { "main": [[{ "node": "Flip Admins Notified = true", "type": "main", "index": 0 }]] },
    "Flip Admins Notified = true": { "main": [[{ "node": "Bump Project.Status = Admin Review", "type": "main", "index": 0 }]] },
    "Bump Project.Status = Admin Review": { "main": [[{ "node": "Log to Automation Log", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "ks-automation" }, { "name": "v2.1.2" }]
}
