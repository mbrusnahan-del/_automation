# Kingdom Structural automation — environment configuration template.
#
# Copy to `.env` next to sweep.py, fill in real values, and never commit it.
# run_sweep.bat auto-loads this file.


# ── Notion ────────────────────────────────────────────────────────────
# 1. Create an internal integration at https://www.notion.so/my-integrations
# 2. Share Projects, Proposal Brief, and Automation Log DBs with it
#    (⋯ menu on each DB → "Add connections")
# 3. Paste the "Internal Integration Secret" here
NOTION_TOKEN=ntn_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── Email ─────────────────────────────────────────────────────────────
# Options:
#   notion — sweep only flips state flags; the user's own Notion automations
#            handle engineer/admin notifications (RECOMMENDED when Notion
#            workflow automations exist — no SMTP setup needed)
#   stub   — writes .eml files to _pending_email/ (safe for testing)
#   send   — real SMTP send via Office 365 (needs Authenticated SMTP enabled
#            on the mailbox — disabled by default in most M365 tenants)
#   draft  — Cowork-integrated Gmail draft (only works in Cowork sessions)
KS_EMAIL_MODE=notion

# Required when KS_EMAIL_MODE=send:
# Generate an App Password at https://account.microsoft.com/security
# (the mailbox password itself won't work if MFA is enabled)
KS_SMTP_USER=mbrusnahan@kingdomstructural.com
KS_SMTP_PASS=your-app-password-here
# KS_SMTP_HOST defaults to smtp.office365.com
# KS_SMTP_PORT defaults to 587
# KS_SMTP_FROM defaults to KS_SMTP_USER


# ── OneDrive root path (Windows) ──────────────────────────────────────
# The sweep uses this when building SharePoint Folder URLs stamped into
# Notion. Change only if the local OneDrive root differs from the default.
KS_ONEDRIVE_WIN_ROOT=C:/Users/MichaelBrusnahan/OneDrive - Kingdom Structural LLC


# ── n8n hybrid webhook (only needed if running n8n/webhook_server.py) ─
# Shared secret that authenticates requests from n8n to webhook_server.py.
# Set the same value in n8n's env (KS_WEBHOOK_TOKEN variable) so the two
# ends match. Generate a random 32+ character string — any value works
# as long as both sides agree.
KS_WEBHOOK_TOKEN=generate-a-random-string-32-chars-or-more
